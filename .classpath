	<classpathentry kind="lib" path="lib/jakarta.mail-api-2.1.5.jar"/>
	<classpathentry kind="lib" path="lib/angus-mail-2.0.5.jar"/>
	<classpathentry kind="output" path="bin"/>
</classpath>
